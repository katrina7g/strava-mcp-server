{
  "name": "strava-mcp-server",
  "version": "0.1.0",
  "description": "Local, read-only MCP server for Strava data exports.",
  "main": "./dist/server.js",
  "bin": {
    "strava-mcp-server": "./dist/server.js"
  },
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && chmod +x dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "strava",
    "mcp",
    "model-context-protocol",
    "training",
    "fitness",
    "local-first"
  ],
  "author": "katrina7g",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katrina7g/strava-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/katrina7g/strava-mcp-server/issues"
  },
  "homepage": "https://github.com/katrina7g/strava-mcp-server#readme",
  "dependencies": {
    "@garmin/fitsdk": "^21.213.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.10.0",
    "saxes": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
